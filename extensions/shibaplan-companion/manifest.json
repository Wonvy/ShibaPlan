{
  "manifest_version": 3,
  "name": "ShibaPlan 浏览器助手",
  "version": "0.2.12",
  "description": "通用的 ShibaPlan 专用浏览器扩展：支持内置/自定义 JS 采集脚本、点选元素生成监控、右键推送选中文本与时间倒计时到 ShibaPlan。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "contextMenus",
    "activeTab",
    "userScripts"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ShibaPlan 浏览器助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "collectors/xiaohongshu.js",
        "collectors/selector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
